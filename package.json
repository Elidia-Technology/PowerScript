{
  "name": "powerscript",
  "version": "1.0.0",
  "description": "A comprehensive Node.js module that allows developers to write ActionScript 3 style code with built-in AI/ML, distributed systems, and cloud-native capabilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ps": "./bin/ps.js",
    "powerscript": "./bin/ps.js"
  },
  "scripts": {
    "build": "tsc && npm run build:cli",
    "build:cli": "tsc -p tsconfig.cli.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docs": "typedoc src --out docs",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "compile": "node bin/ps.js compile",
    "repl": "node bin/ps.js repl"
  },
  "keywords": [
    "actionscript",
    "typescript",
    "compiler",
    "ai",
    "ml",
    "distributed-systems",
    "cloud-native",
    "nodejs",
    "powerscript"
  ],
  "author": "PowerScript Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
