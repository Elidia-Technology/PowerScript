{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./bin",
    "rootDir": "./",
    "declaration": false,
    "declarationMap": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "cli/**/*",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}